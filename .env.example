# ============================================================
# SYNAI.SHOP — Environment Variables
# Copy to .env and fill in your values before running.
# ============================================================

# --- Database ---
DATABASE_URL=sqlite:///atp_dev.db          # Use postgresql:// in production

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-random-string

# --- Chain (Base L2) ---
RPC_URL=
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# --- X Layer (default chain) ---
DEFAULT_CHAIN_ID=196
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_USDC_CONTRACT=0x4ae46a509f6b1d9056937ba4500cb143933d2dc8
XLAYER_TOKEN_SYMBOL=USDG
XLAYER_TOKEN_EIP712_NAME=Global Dollar
XLAYER_TOKEN_EIP712_VERSION=1

# --- Wallets ---
OPERATIONS_WALLET_ADDRESS=               # EIP-55 checksum address for payouts/refunds
OPERATIONS_WALLET_KEY=                    # Private key (never commit this)
FEE_WALLET_ADDRESS=                       # Platform fee recipient
OPERATOR_ADDRESS=                         # Privileged operations (solvency endpoint)

# --- Oracle LLM ---
ORACLE_LLM_BASE_URL=https://openrouter.ai/api/v1
ORACLE_LLM_API_KEY=                       # OpenRouter or OpenAI-compatible API key
ORACLE_LLM_MODEL=openai/gpt-4o
ORACLE_PASS_THRESHOLD=65
ORACLE_MAX_ROUNDS=6
ORACLE_TIMEOUT_SECONDS=120

# --- OKX OnchainOS ---
ONCHAINOS_API_KEY=
ONCHAINOS_SECRET_KEY=
ONCHAINOS_PASSPHRASE=
ONCHAINOS_PROJECT_ID=

# --- x402 Payment Protocol ---
X402_ENABLED=true
X402_COINBASE_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_OKX_FACILITATOR_URL=https://web3.okx.com/api/v6/x402

# --- Platform ---
PLATFORM_FEE_BPS=2000                     # 20% (basis points)
MIN_TASK_AMOUNT=0.1                       # Minimum task price in USDG (X Layer) or USDC (Base)
SOLUTION_VIEW_FEE_PERCENT=70

# --- Blacklist (comma-separated lowercase addresses) ---
BLACKLIST_ADDRESSES=
